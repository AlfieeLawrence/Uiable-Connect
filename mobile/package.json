{
  "name": "uiable-connect-mobile",
  "version": "1.2.0",
  "private": true,
  "description": "Uiable Connect for iPhone, iPad and Android (Capacitor). Reuses ../src for the UI.",
  "author": "Alfie Lawrence",
  "license": "MIT",
  "scripts": {
    "web": "node scripts/build-web.js",
    "assets": "npx --yes @capacitor/assets@3 generate --iconBackgroundColor '#0b0d14' --iconBackgroundColorDark '#0b0d14' --splashBackgroundColor '#0b0d14' --splashBackgroundColorDark '#0b0d14'",
    "sync": "npm run web && cap sync",
    "android:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "ios:open": "npm run sync && cap open ios",
    "capacitor:sync:after": "node scripts/ios-fix.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/browser": "^6.0.4",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.3",
    "uiable-ssh": "file:plugin"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
